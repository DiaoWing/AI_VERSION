/* ============================================================
   全局样式
   ============================================================ */

QMainWindow {
    background-color: #f5f5f5;
}

/* ============================================================
   菜单栏样式
   ============================================================ */

QMenuBar {
    background-color: #d5d9e0;  /* 更深灰，带一点蓝灰调 */
    color: #1a1a1a;
    border-bottom: 2px solid #b0b5ba;
    font-size: 13px;
    font-weight: 500;
    min-height: 32px;
    padding: 2px 8px;
}

QMenuBar::item {
    background: transparent;
    padding: 6px 16px;
    margin: 2px 2px;
    border-radius: 4px;
    color: #1a1a1a;
}

QMenuBar::item:selected {
    background-color: #b8bfc8;  /* 悬停更深 */
    color: #004080;
}

QMenuBar::item:pressed {
    background-color: #9ea7b2;  /* 点击更深 */
    color: #004080;
}

/* ============================================================
   下拉菜单样式
   ============================================================ */

QMenu {
    background-color: #ffffff;
    border: 1px solid #dee2e6;
    border-radius: 6px;
    padding: 4px 0px;
    color: #333333;
}

QMenu::item {
    padding: 8px 35px 8px 20px;
    margin: 2px 6px;
    border-radius: 4px;
    color: #333333;
    font-size: 13px;
}

QMenu::item:selected {
    background-color: #e3f2fd;
    color: #1976d2;
}

QMenu::item:disabled {
    color: #adb5bd;
}

QMenu::separator {
    height: 1px;
    background-color: #e9ecef;
    margin: 4px 12px;
}

QMenu::icon {
    padding-left: 8px;
    padding-right: 12px;
}

QMenu::right-arrow {
    width: 8px;
    height: 8px;
    background-color: #6c757d;
    border-radius: 1px;
    margin-right: 8px;
}

/* ============================================================
   可勾选的菜单项
   ============================================================ */

QMenu::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #dee2e6;
    border-radius: 3px;
    background-color: #ffffff;
    margin-right: 8px;
}

QMenu::indicator:checked {
    background-color: #1976d2;
    border-color: #1976d2;
}

QMenu::indicator:checked:selected {
    background-color: #1565c0;
    border-color: #1565c0;
}

/* ============================================================
   分组框样式
   ============================================================ */

QGroupBox {
    border: 2px solid #3498db;
    border-radius: 8px;
    margin-top: 10px;
    font-size: 14px;
    font-weight: bold;
    color: #2c3e50;
    background-color: rgba(255, 255, 255, 0.5);
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px 0 5px;
}

/* ============================================================
   按钮样式
   ============================================================ */

QPushButton {
    background-color: #3498db;
    color: white;
    border: none;
    padding: 8px 15px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #2980b9;
}

QPushButton:pressed {
    background-color: #1c6b9c;
}

QPushButton:disabled {
    background-color: #bdc3c7;
    color: #7f8c8d;
}

/* 连接按钮 - 绿色 */
QPushButton#pushButton_connect {
    background-color: #28a745;
}

QPushButton#pushButton_connect:hover {
    background-color: #218838;
}

QPushButton#pushButton_connect:pressed {
    background-color: #1e7e34;
}

QPushButton#pushButton_connect:disabled {
    background-color: #bdc3c7;
    color: #7f8c8d;
}

/* 断开按钮 - 红色 */
QPushButton#pushButton_disconnect {
    background-color: #dc3545;
}

QPushButton#pushButton_disconnect:hover {
    background-color: #c82333;
}

QPushButton#pushButton_disconnect:pressed {
    background-color: #bd2130;
}

QPushButton#pushButton_disconnect:disabled {
    background-color: #bdc3c7;
    color: #7f8c8d;
}

/* 刷新按钮 - 灰色 */
QPushButton#pushButton_refreshPorts {
    background-color: #6c757d;
}

QPushButton#pushButton_refreshPorts:hover {
    background-color: #5a6268;
}

QPushButton#pushButton_refreshPorts:pressed {
    background-color: #4e555b;
}

/* 清空日志按钮 - 灰色 */
QPushButton#pushButton_clearLog {
    background-color: #6c757d;
}

QPushButton#pushButton_clearLog:hover {
    background-color: #5a6268;
}

QPushButton#pushButton_clearLog:pressed {
    background-color: #4e555b;
}

/* ============================================================
   下拉框样式
   ============================================================ */


/* ============================================================
   数字输入框样式
   ============================================================ */

QSpinBox {
    border: 1px solid #bdc3c7;
    border-radius: 4px;
    padding: 4px 8px;
    background-color: white;
    min-width: 60px;
    min-height: 20px;
}

QSpinBox:focus {
    border-color: #3498db;
}

QSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 16px;
}

QSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 16px;
}

/* ============================================================
   复选框样式
   ============================================================ */

QCheckBox {
    spacing: 5px;
    color: #2c3e50;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #bdc3c7;
    border-radius: 3px;
    background-color: white;
}

QCheckBox::indicator:checked {
    background-color: #3498db;
    border-color: #3498db;
}

QCheckBox::indicator:hover {
    border-color: #3498db;
}

/* ============================================================
   标签样式
   ============================================================ */

QLabel {
    color: #2c3e50;
}

QLabel#label_status {
    font-weight: bold;
    font-size: 13px;
}

QLabel#label_connectionInfo {
    color: #6c757d;
    font-size: 11px;
}

/* ============================================================
   文本编辑框（调试信息）
   ============================================================ */

QTextEdit#textEditDebug {
    background-color: #1e1e1e;
    color: #d4d4d4;
    border: 1px solid #3c3c3c;
    border-radius: 4px;
    padding: 8px;
}

QTextEdit#textEditDebug:focus {
    border-color: #3498db;
}

/* ============================================================
   状态栏样式
   ============================================================ */

QStatusBar {
    background-color: #34495e;
    color: white;
    min-height: 25px;
}

QStatusBar::item {
    border: none;
}

/* ============================================================
   滚动条样式
   ============================================================ */

QScrollBar:vertical {
    border: none;
    background-color: #f0f0f0;
    width: 10px;
    border-radius: 5px;
}

QScrollBar::handle:vertical {
    background-color: #c1c1c1;
    border-radius: 5px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background-color: #a8a8a8;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    border: none;
    background: none;
}

QScrollBar:horizontal {
    border: none;
    background-color: #f0f0f0;
    height: 10px;
    border-radius: 5px;
}

QScrollBar::handle:horizontal {
    background-color: #c1c1c1;
    border-radius: 5px;
    min-width: 20px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #a8a8a8;
}

/* ============================================================
   工具提示样式
   ============================================================ */

QToolTip {
    background-color: #2c3e50;
    color: white;
    border: 1px solid #3498db;
    border-radius: 3px;
    padding: 5px;
}

/* ============================================================
   选项卡样式
   ============================================================ */

QTabWidget::pane {
    border: 1px solid #dee2e6;
    border-radius: 4px;
    background-color: white;
}

QTabBar::tab {
    background-color: #e9ecef;
    color: #2c3e50;
    padding: 8px 15px;
    margin-right: 2px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}

QTabBar::tab:selected {
    background-color: white;
    color: #3498db;
    font-weight: bold;
}

QTabBar::tab:hover {
    background-color: #dee2e6;
}

/* ============================================================
   表格样式
   ============================================================ */

QTableWidget {
    border: 1px solid #dee2e6;
    background-color: white;
    gridline-color: #e9ecef;
}

QTableWidget::item {
    padding: 5px;
}

QTableWidget::item:selected {
    background-color: #3498db;
    color: white;
}

QHeaderView::section {
    background-color: #e9ecef;
    color: #2c3e50;
    padding: 5px;
    border: 1px solid #dee2e6;
    font-weight: bold;
}
